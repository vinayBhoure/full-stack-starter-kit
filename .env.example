# Choose which Prisma schema to use: "postgresql" or "mongodb".
# Whenever you change this, run `npm run db:switch` (or just `npm run dev` / `npm run build`,
# which do it automatically) to regenerate the Prisma client for the right provider.
DATABASE_PROVIDER=postgresql

# --- PostgreSQL (Neon) ---
# Neon dashboard -> your project -> Connect -> "Prisma" tab -> copy the connection string.
# Example: postgresql://user:password@ep-xxxx-pooler.neon.tech/dbname?sslmode=require
#
# --- MongoDB (Atlas) ---
# Atlas dashboard -> your cluster -> Connect -> Drivers -> copy the connection string.
# Example: mongodb+srv://user:password@cluster0.mongodb.net/dbname?retryWrites=true&w=majority
#
# Paste whichever one matches DATABASE_PROVIDER above:
DATABASE_URL=
